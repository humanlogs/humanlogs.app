generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String          @id @default(uuid())
  auth0Id               String          @unique
  email                 String          @unique
  name                  String?
  picture               String?
  passwordHash          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  credits               Int             @default(100)
  language              String          @default("en")
  plan                  String          @default("free")
  creditsRefill         Int             @default(100)
  creditsUsed           Int             @default(0)
  publicKey             String?
  trustedDeviceSecret   String?
  stripeCustomerId      String?         @unique
  stripeSubscriptionId  String?         @unique
  subscriptionPeriodEnd DateTime?
  subscriptionStatus    String?
  lastCreditsRefill     DateTime?
  // Last time this user completed a payment (one-time purchase or subscription
  // invoice). Null for users who have never paid. Used to order the admin
  // "latest paying customers" list.
  lastPaymentAt         DateTime?
  shortcuts             Json?
  isAdmin               Boolean         @default(false)
  marketingEmailStep    Int             @default(0)
  lastMarketingEmailAt  DateTime?
  projects              Project[]
  transcriptions        Transcription[]
  feedbacks             Feedback[]
  deletionTokens        DeletionToken[]
  isWelcomeDone         Boolean         @default(false)
  // Furthest onboarding step the user reached, so we can see exactly where
  // people drop off. "profile" | "security" | "referral" | "ready" | "done".
  onboardingStep        String          @default("profile")
  // Onboarding profile
  profession            String?
  monthlyUsage          String?
  // Speech-to-text data residency preference: "eu" (Gladia) or "us" (ElevenLabs)
  dataResidency         String          @default("eu")
  // Referral program: extra monthly credits earned from referred users who registered
  referralBonusCredits  Int             @default(0)
  referralsSent         Referral[]
}

enum ReferralStatus {
  INVITED
  REGISTERED
}

model Referral {
  id               String         @id @default(uuid())
  referrerId       String
  email            String
  status           ReferralStatus @default(INVITED)
  registeredUserId String?
  createdAt        DateTime       @default(now())
  registeredAt     DateTime?
  referrer         User           @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, email])
  @@index([referrerId])
  @@index([email])
}

model Project {
  id             String          @id @default(uuid())
  name           String
  userId         String
  // Visual customization. `iconType` is "icon" | "emoji" | "image".
  // - icon:  `icon` holds a curated Lucide icon key, `color` the palette key
  // - emoji: `icon` holds the emoji character, `color` the palette key
  // - image: `imageKey` holds the storage key of the uploaded image
  iconType       String?
  icon           String?
  color          String?
  imageKey       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  transcriptions Transcription[]
  user           User            @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Transcription {
  id                        String             @id @default(uuid())
  userId                    String
  projectId                 String?
  title                     String             @default("")
  audioFileKey              String
  audioFileEncryption       Json?
  audioFileName             String
  audioFileSize             Int
  // Source of the transcript: "audio" (transcribed from audio/video) or "text" (imported document)
  mediaType                 String             @default("audio")
  transcription             Json?
  isTutorial                Boolean            @default(false)
  language                  String
  vocabulary                String[]
  speakerCount              Int                @default(1)
  state                     TranscriptionState @default(PENDING)
  errorMessage              String?
  // STT provider used for this transcription: "gladia" | "elevenlabs" | "whisper"
  sttProvider               String?
  elevenLabsTranscriptionId String?
  shared                    Json?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  updatedBy                 String             @default("system")
  completedAt               DateTime?
  user                      User               @relation(fields: [userId], references: [id])
  project                   Project?           @relation(fields: [projectId], references: [id])

  @@index([id])
  @@index([userId, id])
  @@index([userId, projectId])
  @@index([userId, state])
  @@index([userId, createdAt])
}

enum TranscriptionState {
  PENDING
  COMPLETED
  ERROR
}

model TranscriptionHistory {
  id              String   @id @default(uuid())
  transcriptionId String
  userId          String
  transcription   Json?
  updatedAt       DateTime @updatedAt
  updatedBy       String
  additions       Int      @default(0)
  removals        Int      @default(0)
  changed         Int      @default(0)

  @@index([userId, transcriptionId, updatedAt])
}

model Feedback {
  id        String       @id @default(uuid())
  userId    String
  type      FeedbackType @default(RATING)
  rating    Int?
  message   String?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([type])
}

enum FeedbackType {
  RATING
  FEATURE_REQUEST
}

model DeletionToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// Anti-abuse memory of deleted accounts. Users were deleting their account and
// signing up again to get a fresh free credit balance, so we keep the credit
// state behind a one-way HMAC of the (normalized) email address. No personal
// data is retained: the hash can only be matched, never reversed back to an
// address. Records are purged after `security.deletedAccountRetentionDays`.
model DeletedAccount {
  id             String   @id @default(uuid())
  emailHash      String   @unique
  // Credit balance and usage at the moment the account was deleted. Restored
  // as-is when the same address registers again.
  credits        Int      @default(0)
  creditsUsed    Int      @default(0)
  deletionCount  Int      @default(1)
  firstDeletedAt DateTime @default(now())
  lastDeletedAt  DateTime @default(now())

  @@index([lastDeletedAt])
}

model RateLimit {
  id        String   @id @default(uuid())
  key       String   @unique
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([resetAt])
}

model LandingPageVisit {
  id        String   @id @default(uuid())
  ipHash    String
  page      String   @default("/") // Page path visited (e.g., "/", "/pricing", "/use-cases/research")
  visitDate String // Store as YYYY-MM-DD for easy grouping
  createdAt DateTime @default(now())

  @@unique([ipHash, page, visitDate])
  @@index([visitDate])
  @@index([ipHash])
  @@index([page])
}

model NewsletterSubscription {
  id        String   @id @default(uuid())
  email     String   @unique
  locale    String   @default("en")
  source    String   @default("landing") // Where the signup came from (e.g., "landing", "nvivo-modernization")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
