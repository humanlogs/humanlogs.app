generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String               @id @default(uuid())
  auth0Id               String               @unique
  email                 String               @unique
  name                  String?
  picture               String?
  passwordHash          String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  credits               Int                  @default(100)
  language              String               @default("en")
  plan                  String               @default("free")
  creditsRefill         Int                  @default(100)
  creditsUsed           Int                  @default(0)
  publicKey             String?
  trustedDeviceSecret   String?
  stripeCustomerId      String?              @unique
  stripeSubscriptionId  String?              @unique
  subscriptionPeriodEnd DateTime?
  subscriptionStatus    String?
  lastCreditsRefill     DateTime?
  // Last time this user completed a payment (one-time purchase or subscription
  // invoice). Null for users who have never paid. Used to order the admin
  // "latest paying customers" list.
  lastPaymentAt         DateTime?
  shortcuts             Json?
  isAdmin               Boolean              @default(false)
  marketingEmailStep    Int                  @default(0)
  lastMarketingEmailAt  DateTime?
  projects              Project[]
  transcriptions        Transcription[]
  feedbacks             Feedback[]
  deletionTokens        DeletionToken[]
  isWelcomeDone         Boolean              @default(false)
  // Furthest onboarding step the user reached, so we can see exactly where
  // people drop off. "profile" | "security" | "referral" | "ready" | "done".
  onboardingStep        String               @default("profile")
  // Onboarding profile
  profession            String?
  monthlyUsage          String?
  // Speech-to-text data residency preference: "eu" (Gladia) or "us" (ElevenLabs)
  dataResidency         String               @default("eu")
  // Referral program: extra monthly credits earned from referred users who registered
  referralBonusCredits  Int                  @default(0)
  referralsSent         Referral[]
  comments              Comment[]
  codebooks             Codebook[]
  notifications         Notification[]       @relation("NotificationRecipient")
  threadSubscriptions   ThreadSubscription[]
}

enum ReferralStatus {
  INVITED
  REGISTERED
}

model Referral {
  id               String         @id @default(uuid())
  referrerId       String
  email            String
  status           ReferralStatus @default(INVITED)
  registeredUserId String?
  createdAt        DateTime       @default(now())
  registeredAt     DateTime?
  referrer         User           @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, email])
  @@index([referrerId])
  @@index([email])
}

model Project {
  id             String          @id @default(uuid())
  name           String
  userId         String
  // Visual customization. `iconType` is "icon" | "emoji" | "image".
  // - icon:  `icon` holds a curated Lucide icon key, `color` the palette key
  // - emoji: `icon` holds the emoji character, `color` the palette key
  // - image: `imageKey` holds the storage key of the uploaded image
  iconType       String?
  icon           String?
  color          String?
  imageKey       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  transcriptions Transcription[]
  codebooks      CodebookStudy[]
  user           User            @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// A set of codes used to tag documents. Attached to specific studies or to all
/// of them, optionally nested under a parent codebook to build sub-themes.
///
/// Only `content` is end-to-end encrypted (an EncryptedDataEntity holding
/// `{ name, codes }`), exactly like `Comment.body`. The structure around it —
/// parent, studies, target, and the code uuids stored on documents — stays in
/// clear so the server can scope, cascade and filter without ever learning what
/// a code means.
model Codebook {
  id         String          @id @default(uuid())
  userId     String
  parentId   String?
  /// True when the codebook applies to every study of the user; otherwise the
  /// `studies` links decide.
  allStudies Boolean         @default(false)
  /// Smallest unit this codebook is meant to tag:
  /// "document" | "sentence" | "subsentence" | "word".
  target     String          @default("document")
  /// Key of the preset it was created from, null for a hand-made codebook.
  preset     String?
  /// EncryptedDataEntity, or `{ name, codes }` in clear when the user has no
  /// encryption key.
  content    Json
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  parent     Codebook?       @relation("CodebookTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Codebook[]      @relation("CodebookTree")
  studies    CodebookStudy[]
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentId])
}

model CodebookStudy {
  codebookId String
  projectId  String
  codebook   Codebook @relation(fields: [codebookId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([codebookId, projectId])
  @@index([projectId])
}

model Transcription {
  id                        String             @id @default(uuid())
  userId                    String
  projectId                 String?
  title                     String             @default("")
  audioFileKey              String
  audioFileEncryption       Json?
  audioFileName             String
  audioFileSize             Int
  // Source of the transcript: "audio" (transcribed from audio/video) or "text" (imported document)
  mediaType                 String             @default("audio")
  transcription             Json?
  isTutorial                Boolean            @default(false)
  language                  String
  vocabulary                String[]
  speakerCount              Int                @default(1)
  state                     TranscriptionState @default(PENDING)
  errorMessage              String?
  // STT provider used for this transcription: "gladia" | "elevenlabs" | "whisper"
  sttProvider               String?
  elevenLabsTranscriptionId String?
  shared                    Json?
  // Codes applied to this document: [{ codebookId, codeId }]. Both are opaque
  // uuids — the labels live inside the codebook's encrypted content, so this
  // stays readable by the server without leaking what the codes mean.
  codes                     Json?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  updatedBy                 String             @default("system")
  completedAt               DateTime?
  user                      User               @relation(fields: [userId], references: [id])
  project                   Project?           @relation(fields: [projectId], references: [id])
  comments                  Comment[]

  @@index([id])
  @@index([userId, id])
  @@index([userId, projectId])
  @@index([userId, state])
  @@index([userId, createdAt])
}

enum TranscriptionState {
  PENDING
  COMPLETED
  ERROR
}

model TranscriptionHistory {
  id              String   @id @default(uuid())
  transcriptionId String
  userId          String
  transcription   Json?
  updatedAt       DateTime @updatedAt
  updatedBy       String
  additions       Int      @default(0)
  removals        Int      @default(0)
  changed         Int      @default(0)

  @@index([userId, transcriptionId, updatedAt])
}

/// A comment thread anchor lives in the transcript as a `comment` mark (serialized
/// into segment `comments`), so the anchored range is CRDT-synced, versioned with the
/// transcript, and survives reseed (a revert restores the anchors, which re-link to
/// these rows by `anchorId`). The note bodies live here, one row per note, so a single
/// anchor (`anchorId`) can hold a multi-user thread. `body` is an EncryptedDataEntity
/// (AES-GCM payload + per-authorized-user RSA-wrapped key) when the transcription is
/// encrypted, or plain `{ text }` otherwise.
model Comment {
  id              String        @id @default(uuid())
  transcriptionId String
  // Groups notes into a thread; equals the `commentId` attribute of the mark in the doc.
  anchorId        String
  // Author of this note.
  userId          String
  // EncryptedDataEntity (encrypted) or { text: string } (plaintext).
  body            Json
  resolved        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  transcription   Transcription @relation(fields: [transcriptionId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([transcriptionId])
  @@index([transcriptionId, anchorId])
}

/// Generic in-app notification. Deliberately feature-agnostic: `type` names the event
/// ("comment.reply", "comment.mention", …) and `entityType`/`entityId` point at whatever
/// it concerns, so other features can emit notifications without schema changes.
///
/// `data` holds only what is needed to render a one-line summary and build a link —
/// never user content. Comment bodies are end-to-end encrypted, so a notification
/// references the comment rather than quoting it, and the client renders the wording.
model Notification {
  id         String    @id @default(uuid())
  /// Who receives it.
  userId     String
  /// Event name, e.g. "comment.mention". Unknown types render with a generic fallback.
  type       String
  /// Who caused it (null for system notifications).
  actorId    String?
  /// What it is about, e.g. "transcription".
  entityType String?
  entityId   String?
  data       Json?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Opt-in/opt-out of a comment thread. A row exists only once the user has expressed
/// (or implicitly acquired) an interest: posting in a thread or being mentioned
/// subscribes them, and `subscribed = false` records an explicit opt-out so it is not
/// silently re-added.
model ThreadSubscription {
  id              String   @id @default(uuid())
  userId          String
  transcriptionId String
  /// The comment thread, matching Comment.anchorId.
  anchorId        String
  subscribed      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, transcriptionId, anchorId])
  @@index([transcriptionId, anchorId])
}

model Feedback {
  id        String       @id @default(uuid())
  userId    String
  type      FeedbackType @default(RATING)
  rating    Int?
  message   String?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([type])
}

enum FeedbackType {
  RATING
  FEATURE_REQUEST
}

model DeletionToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model RateLimit {
  id        String   @id @default(uuid())
  key       String   @unique
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([resetAt])
}

model LandingPageVisit {
  id        String   @id @default(uuid())
  ipHash    String
  page      String   @default("/") // Page path visited (e.g., "/", "/pricing", "/use-cases/research")
  visitDate String // Store as YYYY-MM-DD for easy grouping
  createdAt DateTime @default(now())

  @@unique([ipHash, page, visitDate])
  @@index([visitDate])
  @@index([ipHash])
  @@index([page])
}

model NewsletterSubscription {
  id        String   @id @default(uuid())
  email     String   @unique
  locale    String   @default("en")
  source    String   @default("landing") // Where the signup came from (e.g., "landing", "nvivo-modernization")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
